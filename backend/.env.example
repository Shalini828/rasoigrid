# Copy to backend/.env and fill in.

# PostgreSQL connection string (SQLite also works for local testing:
# DATABASE_URL=sqlite:///./rasoigrid.db)
DATABASE_URL=postgresql://rasoigrid:change-me@localhost:5432/rasoigrid

# Secret used to sign login tokens. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Where the frontend runs (allowed by CORS). Separate several with commas.
FRONTEND_URL=http://localhost:5173

# true (default): the app creates missing tables itself when it starts.
# Set to false on a deployed server, where start.sh runs Alembic migrations.
AUTO_CREATE_TABLES=true

# Optional. Without it, /api/predictions uses a simple rule-based fallback.
GEMINI_API_KEY=

# Used only by create_admin.py to create or reset the admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
